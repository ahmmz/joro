# ==============================================================================
# Joro Docker Deployment Environment Configuration Example
# Copy this file to `.env` and modify the values to fit your deployment needs.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Non-Root Execution & Permission Settings
# ------------------------------------------------------------------------------
# Specify the UID and GID of your host user to ensure that files created inside
# the `./data` bind mount match your host system's file ownership.
# On Linux, run `id -u` and `id -g` to find these values.
PUID=1000
PGID=1000

# Specify your server/container timezone (e.g., UTC, America/New_York).
TIMEZONE=UTC

# ------------------------------------------------------------------------------
# 2. General Server Configurations
# ------------------------------------------------------------------------------
# Address to bind the Joro servers to (0.0.0.0 exposes them to the network).
JORO_BIND=0.0.0.0

# Directory inside the container where certificates, databases, and plugins are stored.
JORO_DATA_DIR=/data

# Port where the intercepting HTTP/HTTPS proxy listens inside the container.
JORO_PROXY_PORT=8080

# Port where the control UI and REST/WebSocket API listen inside the container.
JORO_UI_PORT=9090

# Disable automatic update checks at startup and in the background.
# Recommended for Docker environments to maintain predictable deployments.
JORO_DISABLE_UPDATE_CHECKS=true

# ------------------------------------------------------------------------------
# 3. Callback Listener Settings (Required for Listener / Team Server Modes)
# ------------------------------------------------------------------------------
# To activate listener mode, set this to true (unnecessary if using Compose profiles).
JORO_LISTENER=false

# To activate authenticated team server mode, set this to true (requires JORO_LISTENER=true).
JORO_TEAMSERVER=false

# --- Callback Listener Ports (Internal Container Ports) ---
# Note: Changing these internal ports requires updating the port mapping in docker-compose.yml.
JORO_DNS_PORT=1053
JORO_HTTP_PORT=1080
JORO_HTTPS_PORT=1443
JORO_SMTP_PORT=1025
JORO_SMTPS_PORT=1465

# --- Callback Domain & External Routing ---
# The root domain used to capture out-of-band interactions (e.g., collaborator domains).
# JORO_COLLABORATOR_DOMAIN=oast.yourdomain.com

# The domain used to access the control UI / API via a reverse proxy like Traefik.
# Highly recommended to be different from JORO_COLLABORATOR_DOMAIN to prevent active discovery of your admin panel.
# JORO_DOMAIN=joro.yourdomain.com

# The external IP address of this server, returned in DNS A replies.
# JORO_RESPONSE_IP=1.2.3.4

# --- External TLS Configurations ---
# Optional paths to custom PEM-encoded certificate and key files (must be mapped into the container).
# If omitted, Joro automatically generates a leaf certificate signed by its internal CA.
# JORO_TLS_CERT=/data/custom-cert.pem
# JORO_TLS_KEY=/data/custom-key.pem

# ------------------------------------------------------------------------------
# 4. Developer Configurations (Only used for developing Joro UI/API)
# ------------------------------------------------------------------------------
# Enables reverse-proxying of UI requests to a local Vite developer server.
JORO_DEV=false
JORO_VITE_URL=http://localhost:5173
